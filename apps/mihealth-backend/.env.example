# Copy to .env and adjust. Defaults work for local docker-compose.
DATABASE_URL=postgresql+psycopg2://mihealth:mihealth@db:5432/mihealth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
TSPI_BASE_URL=http://host.docker.internal:8000
SEED_ADMIN_EMAIL=admin@mihealth.app
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Default Admin
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=/data/uploads
OCR_USE_LLM=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# Optional: path to tesseract.exe if not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
