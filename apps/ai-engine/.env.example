# TSPI AI Engine — single sample env. Copy to .env and fill in. NEVER commit real secrets.
#
# One file for both setups:
#   • LOCAL (uvicorn on your machine): set the values marked [local].
#   • DOCKER (docker compose):        [docker] infra values (DATABASE_URL, OLLAMA_BASE_URL) are set
#                                      by compose and will OVERRIDE anything here — leave them unset.
# Env-var names map directly to settings (no prefix): AUTH_ENABLED -> settings.auth_enabled, etc.

# --- App ---
TSPI_ENV=local
TSPI_LOG_LEVEL=INFO

# --- Database ---
# [local] Leave unset to use the zero-config SQLite dev DB (data/tspi.db).
#         For prod parity, run Postgres+pgvector and set:
# DATABASE_URL=postgresql+psycopg://tspi:tspi@localhost:5432/tspi
# [docker] Do NOT set — compose injects DATABASE_URL (Postgres) automatically.
VECTOR_BACKEND=pgvector            # pgvector (one DB) | chroma

# --- Embeddings ---
EMBEDDING_BACKEND=hash             # hash (dev, no deps) | ollama (local, private) | api (managed)
EMBEDDING_DIM=384                  # MUST match the model: hash=384, bge-m3=1024, nomic=768, openai-3-small=1536
OLLAMA_EMBEDDING_MODEL=bge-m3      # used when EMBEDDING_BACKEND=ollama (then set EMBEDDING_DIM=1024; `ollama pull bge-m3`)
# For the managed API backend instead:
# EMBEDDING_BACKEND=api
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-embeddings-key
# EMBEDDING_MODEL=text-embedding-3-small   # then set EMBEDDING_DIM=1536

# --- LLM layer (report writer) ---
LLM_PRIMARY=deepseek               # deepseek | ollama | claude | groq
# DeepSeek (OpenAI-compatible):
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_MODEL=qwen2.5:14b           # used when LLM_PRIMARY=ollama (local fallback)

# --- Ollama endpoint (SHARED by the ollama embedding backend AND the ollama LLM) ---
# [local] point at your Ollama server:
OLLAMA_BASE_URL=http://localhost:11434
# [docker] Do NOT set — compose injects OLLAMA_BASE_URL (in-stack ollama) automatically.

# --- Auth / RBAC / audit (Phase B) ---
# OFF by default so the local pilot + MiHealth keep working unchanged. Turn ON per environment
# once service tokens are issued. The trusted caller (MCP server / MiHealth) sends one of these
# bearer tokens AND forwards the end-user identity via X-TSPI-User-Id / -Role / -Clinic-Id.
AUTH_ENABLED=false
# Comma-separated service bearer tokens (strong random values; never commit real ones):
# SERVICE_TOKENS=svc-mihealth-REPLACE_ME,svc-mcp-REPLACE_ME

# --- Governance ---
REQUIRE_DOCTOR_VALIDATION=true
ENFORCE_DEIDENTIFICATION=true

# --- Ops (docker only; ignored for local uvicorn) ---
WEB_CONCURRENCY=2                  # uvicorn workers (scale to CPU)
RUN_EMBED_ON_START=false           # true = embed knowledge on container start (model must be pulled)
POSTGRES_PASSWORD=change-me-in-prod
