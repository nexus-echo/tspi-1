# Copy to .env and fill in. Never commit real secrets.

# --- App ---
TSPI_ENV=local
TSPI_LOG_LEVEL=INFO

# --- Database (Phase 0+) ---
# Leave unset to use the zero-config SQLite dev DB (data/tspi.db).
# For dev/prod parity, run `docker compose up -d db` and use Postgres + pgvector:
# DATABASE_URL=postgresql+psycopg://tspi:tspi@localhost:5432/tspi
VECTOR_BACKEND=pgvector            # pgvector (one DB) | chroma

# --- Embeddings (Phase 2) ---
EMBEDDING_BACKEND=hash             # hash (dev) | ollama (local, private) | api (managed)
EMBEDDING_DIM=384                  # MUST match the model: hash=384, bge-m3=1024, nomic=768, openai-3-small=1536
# For ollama backend (local, recommended for private health data):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=bge-m3    # then set EMBEDDING_DIM=1024  (pull first: `ollama pull bge-m3`)
# For api backend:
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-embeddings-key
# EMBEDDING_MODEL=text-embedding-3-small   # then set EMBEDDING_DIM=1536

# --- LLM layer ---
LLM_PRIMARY=deepseek                  # deepseek | ollama | claude | groq
# DeepSeek (OpenAI-compatible):
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Ollama (local fallback):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
