# Copy to .env for `docker compose`. Infra URLs (DATABASE_URL, OLLAMA_BASE_URL) are set by compose.

# --- LLM (report writer) ---
LLM_PRIMARY=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
# (Ollama is also available in-stack as a local LLM fallback; OLLAMA_MODEL=qwen2.5:14b)

# --- Embeddings (RAG) ---
EMBEDDING_BACKEND=ollama            # ollama (local, in-stack) | api | hash
EMBEDDING_DIM=1024                  # bge-m3 = 1024 (match your model!)
OLLAMA_EMBEDDING_MODEL=bge-m3
# For api backend instead:
# EMBEDDING_BACKEND=api
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- Ops ---
WEB_CONCURRENCY=2                   # uvicorn workers (scale to CPU)
RUN_EMBED_ON_START=false           # true = embed knowledge on container start (model must be pulled)
POSTGRES_PASSWORD=change-me-in-prod
# REQUIRE_DOCTOR_VALIDATION=true
